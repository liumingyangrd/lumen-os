/* ============================================================
 *  Lumen 内核核心 (Lumen-C)
 *  显示器 / 键盘 / 磁盘 / LMFS / 调度 / 系统调用 / LMX 加载器
 * ============================================================ */

int mkptr(int a) { return a; }

/* ---------------- 全局状态 ---------------- */
char *vram;
int cx;
int cy;
int conattr;
int ticks;
int kern_busy;
int sched_req;
int fs_ready;
int fsbase;
int shift;
int kbhead;
int kbtail;
int next_pid;
int cur;
int ppos;

char fsbuf[512];
char fsbuf2[512];
char dirtab[4096];
char filebuf[32768];
char kbbuf[64];
char pbuf[1024];

int t_state[12];
int t_sp[12];
int t_base[12];
int t_pid[12];
int t_ppid[12];
int t_code[12];
char t_names[192];
char t_args[768];

/* ---------------- 字符串 ---------------- */
int strlen(char *s) { int i = 0; while (s[i]) i = i + 1; return i; }
int strcmp(char *a, char *b) {
  int i = 0;
  while (a[i] && b[i]) { if (a[i] != b[i]) return a[i] - b[i]; i = i + 1; }
  return a[i] - b[i];
}
void strcpy(char *d, char *s) { int i = 0; while (s[i]) { d[i] = s[i]; i = i + 1; } d[i] = 0; }
void strncpy(char *d, char *s, int n) {
  int i = 0;
  while (i < n - 1 && s[i]) { d[i] = s[i]; i = i + 1; }
  d[i] = 0;
}

int rd32(char *p, int off) {
  int a = p[off];
  int b = p[off + 1];
  int c = p[off + 2];
  int d = p[off + 3];
  return a | (b << 8) | (c << 16) | (d << 24);
}
void wr32(char *p, int off, int v) {
  p[off] = v & 0xff;
  p[off + 1] = (v >> 8) & 0xff;
  p[off + 2] = (v >> 16) & 0xff;
  p[off + 3] = (v >> 24) & 0xff;
}

/* ---------------- 控制台 (32 位码点 + 宽字符) ---------------- */
int u8adv;

int is_wide(int cp) {
  if (cp >= 0x1100 && cp <= 0x115F) return 1;
  if (cp >= 0x2E80 && cp <= 0xA4CF) return 1;
  if (cp >= 0xAC00 && cp <= 0xD7A3) return 1;
  if (cp >= 0xF900 && cp <= 0xFAFF) return 1;
  if (cp >= 0xFE30 && cp <= 0xFE4F) return 1;
  if (cp >= 0xFF00 && cp <= 0xFF60) return 1;
  if (cp >= 0xFFE0 && cp <= 0xFFE6) return 1;
  return 0;
}

int u8_at(char *s, int i) {
  int b = s[i] & 0xff;
  int a = s[i + 1] & 0x3f;
  int c2 = s[i + 2] & 0x3f;
  int d2 = s[i + 3] & 0x3f;
  if (b < 0x80) { u8adv = 1; return b; }
  if ((b & 0xE0) == 0xC0) { u8adv = 2; return ((b & 0x1F) << 6) | a; }
  if ((b & 0xF0) == 0xE0) { u8adv = 3; return ((b & 0x0F) << 12) | (a << 6) | c2; }
  u8adv = 4;
  return ((b & 0x07) << 18) | (a << 12) | (c2 << 6) | d2;
}

void cell_set(int idx, int cp) {
  wr32(vram, idx * 8, cp);
  wr32(vram, idx * 8 + 4, conattr);
}

void cursor_update() {
  int pos = cy * 80 + cx;
  outb(0x3D4, 0x0F); outb(0x3D5, pos & 0xff);
  outb(0x3D4, 0x0E); outb(0x3D5, (pos >> 8) & 0xff);
}

void con_clear() {
  int i = 0;
  while (i < 2000) {
    wr32(vram, i * 8, 32);
    wr32(vram, i * 8 + 4, conattr);
    i = i + 1;
  }
  cx = 0; cy = 0;
  cursor_update();
}

void con_scroll() {
  int *d = mkptr(0xB8000);
  int *s = mkptr(0xB8000 + 640);
  int i = 0;
  while (i < 3840) { d[i] = s[i]; i = i + 1; }
  i = 0;
  while (i < 80) {
    wr32(vram, (80 * 24 + i) * 8, 32);
    wr32(vram, (80 * 24 + i) * 8 + 4, conattr);
    i = i + 1;
  }
  cy = 24;
}

void con_putc(int cp) {
  int w = 1;
  if (cp == 10) { cx = 0; cy = cy + 1; }
  else if (cp == 13) { cx = 0; }
  else if (cp == 8) {
    if (cx > 0) {
      cx = cx - 1;
      if (rd32(vram, cx * 8) == 0xFFFF && cx > 0) cx = cx - 1;
      cell_set(cy * 80 + cx, 32);
      if (rd32(vram, (cy * 80 + cx + 1) * 8) == 0xFFFF) cell_set(cy * 80 + cx + 1, 32);
    }
  } else if (cp == 9) {
    cx = (cx + 4) & 0xFFFC;
    if (cx >= 80) { cx = 0; cy = cy + 1; }
  } else {
    if (is_wide(cp)) w = 2;
    if (cx + w > 80) { cx = 0; cy = cy + 1; }
    cell_set(cy * 80 + cx, cp);
    if (w == 2) wr32(vram, (cy * 80 + cx + 1) * 8 + 4, conattr);
    if (w == 2) wr32(vram, (cy * 80 + cx + 1) * 8, 0xFFFF);
    cx = cx + w;
    if (cx >= 80) { cx = 0; cy = cy + 1; }
  }
  if (cy >= 25) con_scroll();
  cursor_update();
}

void con_puts(char *s) {
  int i = 0;
  while (s[i]) {
    int cp = u8_at(s, i);
    i = i + u8adv;
    con_putc(cp);
  }
}

void con_setattr(int a) { conattr = a & 0xff; }

void print_int(int v) {
  char b[16];
  int i = 0;
  int neg = 0;
  if (v == 0) { con_putc(48); return; }
  if (v < 0) { neg = 1; v = -v; }
  while (v > 0) { b[i] = 48 + (v % 10); i = i + 1; v = v / 10; }
  if (neg) con_putc(45);
  while (i > 0) { i = i - 1; con_putc(b[i]); }
}

void print_hex(int v) {
  char b[16];
  int i = 0;
  int d = 0;
  if (v == 0) { con_putc(48); return; }
  while (v > 0 && i < 12) {
    d = v & 15;
    if (d < 10) b[i] = 48 + d;
    else b[i] = 87 + d;
    i = i + 1;
    v = v >> 4;
  }
  while (i > 0) { i = i - 1; con_putc(b[i]); }
}

void kprintf(char *fmt, int a, int b, int c) {
  int args[3];
  int ai = 0;
  int i = 0;
  args[0] = a; args[1] = b; args[2] = c;
  while (fmt[i]) {
    if (fmt[i] == 37) {
      i = i + 1;
      if (fmt[i] == 100) { print_int(args[ai]); ai = ai + 1; }
      else if (fmt[i] == 120) { print_hex(args[ai]); ai = ai + 1; }
      else if (fmt[i] == 115) { con_puts(mkptr(args[ai])); ai = ai + 1; }
      else if (fmt[i] == 99) { con_putc(args[ai] & 0xff); ai = ai + 1; }
      else if (fmt[i] == 37) con_putc(37);
      i = i + 1;
    } else {
      int cp = u8_at(fmt, i);
      i = i + u8adv;
      con_putc(cp);
    }
  }
}

/* ---------------- 键盘 ---------------- */
void kbd_irq(int code) {
  int c = 0;
  if (code == 57) { shift = 1; return; }
  if (code == 58) { shift = 0; return; }
  if (code >= 1 && code <= 26) c = 97 + code - 1;
  else if (code >= 27 && code <= 36) c = 48 + code - 27;
  else if (code == 37) c = 10;
  else if (code == 38) c = 27;
  else if (code == 39) c = 8;
  else if (code == 40) c = 9;
  else if (code == 41) c = 32;
  else if (code == 42) c = 45;
  else if (code == 43) c = 61;
  else if (code == 44) c = 44;
  else if (code == 45) c = 46;
  else if (code == 46) c = 47;
  else if (code == 47) c = 59;
  else if (code == 48) c = 39;
  else if (code == 49) c = 91;
  else if (code == 50) c = 93;
  else if (code == 51) c = 92;
  else if (code == 52) c = 96;
  else if (code == 53) c = 129;
  else if (code == 54) c = 130;
  else if (code == 55) c = 131;
  else if (code == 56) c = 132;
  if (shift) {
    if (c == 61) c = 43;
    else if (c == 45) c = 95;
    else if (c == 59) c = 58;
    else if (c == 44) c = 60;
    else if (c == 46) c = 62;
    else if (c == 47) c = 63;
    else if (c >= 48 && c <= 57) {
      char *sym = ")!@#$%^&*(";
      c = sym[c - 48];
    }
  }
  if (c >= 97 && c <= 122 && shift) c = c - 32;
  if (c) {
    kbbuf[kbhead] = c;
    kbhead = (kbhead + 1) % 64;
  }
}

int kb_pop() {
  int c = 0;
  if (kbtail != kbhead) {
    c = kbbuf[kbtail];
    kbtail = (kbtail + 1) % 64;
  }
  return c;
}

/* ---------------- 磁盘 ---------------- */
void disk_read(int lba, char *buf) {
  int i = 0;
  outb(0x1F1, lba);
  outb(0x1F2, 1);
  while (i < 512) { buf[i] = inb(0x1F4) & 0xff; i = i + 1; }
}

void disk_write(int lba, char *buf) {
  int i = 0;
  outb(0x1F1, lba);
  outb(0x1F2, 0);
  while (i < 512) { outb(0x1F4, buf[i] & 0xff); i = i + 1; }
  outb(0x1F1, lba);
  outb(0x1F2, 2);
}

/* ---------------- LMFS 文件系统 ---------------- */
/* 块大小 512 字节, 文件系统位于 LBA 512 起
 * 块 0: 超级块 { "LMFS", bs, total, dirStart, dataStart, freeStart }
 * 块 2..9: 目录表 (64 项 x 64 字节)
 * 目录项: name[40] | start(u32) | size(u32) | type(u32) | res(u32)
 */
int fs_mount() {
  int i = 0;
  disk_read(fsbase, fsbuf);
  if (fsbuf[0] != 76) return 0;
  if (fsbuf[1] != 77) return 0;
  if (fsbuf[2] != 70) return 0;
  if (fsbuf[3] != 83) return 0;
  while (i < 8) {
    disk_read(fsbase + 2 + i, dirtab + i * 512);
    i = i + 1;
  }
  fs_ready = 1;
  return 1;
}

void fs_flush_dir() {
  int i = 0;
  while (i < 8) {
    disk_write(fsbase + 2 + i, dirtab + i * 512);
    i = i + 1;
  }
}

int fs_find(char *name) {
  int i = 0;
  while (i < 64) {
    char *e = dirtab + i * 64;
    if (e[0]) {
      if (strcmp(e, name) == 0) return i;
    }
    i = i + 1;
  }
  return -1;
}

int fs_read(char *name, char *buf, int max) {
  int idx = fs_find(name);
  if (idx < 0) return -1;
  char *e = dirtab + idx * 64;
  int start = rd32(e, 40);
  int size = rd32(e, 44);
  int n = size;
  int done = 0;
  if (n > max) n = max;
  while (done < n) {
    disk_read(fsbase + start + done / 512, buf + done);
    done = done + 512;
  }
  return n;
}

int fs_write(char *name, char *buf, int len) {
  int idx = fs_find(name);
  int i = 0;
  int start = 0;
  int blocks = 0;
  if (idx < 0) {
    int free = 0;
    while (free < 64) {
      char *e0 = dirtab + free * 64;
      if (e0[0] == 0) break;
      free = free + 1;
    }
    if (free >= 64) return -1;
    idx = free;
    strncpy(dirtab + idx * 64, name, 40);
  }
  char *e2 = dirtab + idx * 64;
  disk_read(fsbase, fsbuf);
  start = rd32(fsbuf, 24);
  blocks = (len + 511) / 512;
  i = 0;
  while (i < blocks) {
    int j = 0;
    while (j < 512) {
      int k = i * 512 + j;
      fsbuf2[j] = (k < len) ? buf[k] : 0;
      j = j + 1;
    }
    disk_write(fsbase + start + i, fsbuf2);
    i = i + 1;
  }
  wr32(e2, 40, start);
  wr32(e2, 44, len);
  wr32(e2, 48, 1);
  fs_flush_dir();
  disk_read(fsbase, fsbuf);
  wr32(fsbuf, 24, start + blocks);
  disk_write(fsbase, fsbuf);
  return len;
}

int fs_del(char *name) {
  int idx = fs_find(name);
  if (idx < 0) return -1;
  char *e = dirtab + idx * 64;
  e[0] = 0;
  fs_flush_dir();
  return 0;
}

int fs_list(char *buf, int max) {
  int i = 0;
  int n = 0;
  while (i < 64) {
    char *e = dirtab + i * 64;
    if (e[0]) {
      if ((n + 1) * 48 <= max) {
        char *r = buf + n * 48;
        int k = 0;
        while (k < 40) { r[k] = e[k]; k = k + 1; }
        r[39] = 0;
        wr32(r, 40, rd32(e, 44));
        wr32(r, 44, 0);
        n = n + 1;
      }
    }
    i = i + 1;
  }
  return n;
}

/* ---------------- 任务与调度 ---------------- */
void timer_tick() {
  ticks = ticks + 1;
  if (!kern_busy) sched_req = 1;
}

int sched_switch(int sp) {
  int i = 0;
  int n = 0;
  int found = 0;
  t_sp[cur] = sp;
  if (t_state[cur] == 2) t_state[cur] = 1;
  n = cur;
  while (i < 12) {
    n = n + 1;
    if (n >= 12) n = 0;
    if (t_state[n] == 1) { found = 1; i = 11; }
    i = i + 1;
  }
  if (!found) {
    if (t_state[cur] == 1) t_state[cur] = 2;
    return t_sp[cur];
  }
  cur = n;
  t_state[cur] = 2;
  return t_sp[cur];
}

void setup_task(int slot, int base, int entry, int stacktop, char *name, int ppid, char *args) {
  int i = 0;
  int sp = stacktop - 52;
  char *sf = mkptr(sp);
  char *nm = t_names + slot * 16;
  char *ap = t_args + slot * 64;
  while (i < 11) { wr32(sf, i * 4, 0); i = i + 1; }
  wr32(sf, 44, 1);
  wr32(sf, 48, entry);
  t_sp[slot] = sp;
  t_base[slot] = base;
  t_pid[slot] = next_pid;
  t_ppid[slot] = ppid;
  t_code[slot] = 0;
  next_pid = next_pid + 1;
  strncpy(nm, name, 16);
  strncpy(ap, args, 64);
  t_state[slot] = 1;
}

int do_spawn(char *name, char *args) {
  int slot = -1;
  int i = 0;
  int entryOff = 0;
  int imageSize = 0;
  int bssSize = 0;
  int relocCount = 0;
  int relocOff = 0;
  int base = 0;
  char *d;
  if (!fs_ready) return -10;
  while (i < 12) {
    if (i > 0 && t_state[i] == 0 && slot < 0) slot = i;
    i = i + 1;
  }
  if (slot < 0) return -1;
  if (fs_read(name, filebuf, 32000) < 0) return -2;
  if (filebuf[0] != 76) return -3;
  if (filebuf[1] != 77) return -3;
  if (filebuf[2] != 88) return -3;
  if (filebuf[3] != 49) return -3;
  entryOff = rd32(filebuf, 4);
  imageSize = rd32(filebuf, 8);
  bssSize = rd32(filebuf, 12);
  relocCount = rd32(filebuf, 16);
  relocOff = rd32(filebuf, 20);
  if (imageSize <= 0 || imageSize > 32000) return -4;
  base = 0x400000 + slot * 0x40000;
  d = mkptr(base);
  i = 0;
  while (i < imageSize) { d[i] = filebuf[32 + i]; i = i + 1; }
  i = 0;
  while (i < bssSize) { d[imageSize + i] = 0; i = i + 1; }
  i = 0;
  while (i < relocCount) {
    int off = rd32(filebuf, 32 + relocOff + i * 4);
    wr32(d, off, rd32(d, off) + base);
    i = i + 1;
  }
  setup_task(slot, base, base + entryOff, base + 0x3F000, name, t_pid[cur], args);
  return t_pid[slot];
}

int do_wait(int pid) {
  int i = 0;
  while (i < 12) {
    if (t_state[i] != 0 && t_pid[i] == pid) {
      if (t_state[i] == 4) {
        int c = t_code[i];
        t_state[i] = 0;
        return c;
      }
      sched_req = 1;
      return -2;
    }
    i = i + 1;
  }
  return -1;
}

void do_exit(int code) {
  t_code[cur] = code;
  t_state[cur] = 4;
  sched_req = 1;
}

int find_slot(int pid) {
  int i = 0;
  while (i < 12) {
    if (t_state[i] != 0 && t_pid[i] == pid) return i;
    i = i + 1;
  }
  return -1;
}

/* ---------------- 文本缓冲 (供 ps / mem 使用) ---------------- */
void p_reset() { ppos = 0; pbuf[0] = 0; }
void p_str(char *s) {
  int i = 0;
  while (s[i]) { pbuf[ppos] = s[i]; ppos = ppos + 1; i = i + 1; }
  pbuf[ppos] = 0;
}
void p_int(int v) {
  char t[16];
  int i = 0;
  int neg = 0;
  if (v < 0) { neg = 1; v = -v; }
  if (v == 0) { t[i] = 48; i = i + 1; }
  while (v > 0) { t[i] = 48 + (v % 10); i = i + 1; v = v / 10; }
  if (neg) { t[i] = 45; i = i + 1; }
  while (i > 0) { i = i - 1; pbuf[ppos] = t[i]; ppos = ppos + 1; }
  pbuf[ppos] = 0;
}

int do_ps(char *buf) {
  int i = 0;
  p_reset();
  p_str(" PID  PPID  ST   名称\n");
  while (i < 12) {
    if (t_state[i] != 0) {
      char *nm = t_names + i * 16;
      p_int(t_pid[i]);
      p_str("  ");
      p_int(t_ppid[i]);
      p_str("  ");
      p_int(t_state[i]);
      p_str("   ");
      p_str(nm);
      p_str("\n");
    }
    i = i + 1;
  }
  strcpy(buf, pbuf);
  return ppos;
}

int do_meminfo(char *buf) {
  int i = 0;
  int used = 0;
  p_reset();
  p_str("内存总量   16 MiB\n");
  p_str("内核空间   1 MiB  (0x100000)\n");
  p_str("任务槽     12 x 256 KiB @ 0x400000\n");
  while (i < 12) { if (t_state[i] != 0) used = used + 1; i = i + 1; }
  p_str("活动任务   ");
  p_int(used);
  p_str("\n磁盘       256 KiB (LMFS 512 块)\n");
  strcpy(buf, pbuf);
  return ppos;
}

int do_rtc(char *buf) {
  outb(0x70, 9); int y = inb(0x71);
  outb(0x70, 8); int mo = inb(0x71);
  outb(0x70, 7); int da = inb(0x71);
  outb(0x70, 4); int h = inb(0x71);
  outb(0x70, 2); int mi = inb(0x71);
  outb(0x70, 0); int s = inb(0x71);
  p_reset();
  p_int(2000 + y); p_str("-");
  if (mo < 10) p_str("0");
  p_int(mo); p_str("-");
  if (da < 10) p_str("0");
  p_int(da); p_str(" ");
  if (h < 10) p_str("0");
  p_int(h); p_str(":");
  if (mi < 10) p_str("0");
  p_int(mi); p_str(":");
  if (s < 10) p_str("0");
  p_int(s);
  strcpy(buf, pbuf);
  return ppos;
}

/* ---------------- 系统调用 ---------------- */
int sys_dispatch(int nr, int a, int b, int c, int d) {
  if (nr == 0) { do_exit(a); return 0; }
  if (nr == 1) { con_putc(a); return 0; }
  if (nr == 2) { con_puts(mkptr(a)); return 0; }
  if (nr == 3) { return kb_pop(); }
  if (nr == 5) { return ticks; }
  if (nr == 6) { return fs_list(mkptr(a), b); }
  if (nr == 7) { return fs_read(mkptr(a), mkptr(b), c); }
  if (nr == 8) { return fs_write(mkptr(a), mkptr(b), c); }
  if (nr == 9) { return fs_del(mkptr(a)); }
  if (nr == 10) { return do_spawn(mkptr(a), mkptr(b)); }
  if (nr == 11) { return do_wait(a); }
  if (nr == 12) { return t_pid[cur]; }
  if (nr == 13) { return do_ps(mkptr(a)); }
  if (nr == 14) { return do_meminfo(mkptr(a)); }
  if (nr == 15) { sched_req = 1; return 0; }
  if (nr == 16) { return do_rtc(mkptr(a)); }
  if (nr == 17) { con_clear(); return 0; }
  if (nr == 18) { cpu_reboot(); return 0; }
  if (nr == 19) { strncpy(mkptr(a), t_args + cur * 64, b); return strlen(mkptr(a)); }
  if (nr == 20) { conattr = a & 0xff; return 0; }
  if (nr == 21) { return t_ppid[cur]; }
  if (nr == 22) { con_putc(a); return 0; }
  return -1;
}

/* ---------------- 启动 ---------------- */
void banner() {
  con_setattr(0x0B);
  con_puts("\n  ");
  con_puts("  _      _   _ __  __  ___ _  _ \n");
  con_puts("  | |    | | | |  \\/  || __| \\| |\n");
  con_puts("  | |__  | |_| | |\\/| || _|| .` |\n");
  con_puts("  |____|  \\___/|_|  |_||___|_|\\_|\n");
  con_setattr(0x08);
  con_puts("  LUMEN OS · 自研内核 · LUX-32 架构\n\n");
  con_setattr(0x0A);
}

void kmain() {
  int slot = 0;
  int r = 0;
  vram = mkptr(0xB8000);
  conattr = 0x0A;
  cx = 0; cy = 0;
  con_clear();

  banner();

  con_setattr(0x0F);
  kprintf("[ OK ] 内核     Lumen 1.0 @ 0x%x\n", 0x100000, 0, 0);
  con_setattr(0x0A);
  kprintf("[ OK ] 处理器   LUX-32 32 位 · 12 个状态寄存器\n", 0, 0, 0);
  kprintf("[ OK ] 内存     16 MiB 平坦寻址\n", 0, 0, 0);
  kprintf("[ OK ] 显示器   80x25 文本模式 @ 0xB8000\n", 0, 0, 0);
  kprintf("[ OK ] 键盘     LUX 扫描码 · IRQ 1\n", 0, 0, 0);
  kprintf("[ OK ] 时钟     100 Hz · IRQ 0\n", 0, 0, 0);

  fsbase = 256;
  fs_ready = fs_mount();
  if (fs_ready) {
    disk_read(fsbase, fsbuf);
    kprintf("[ OK ] 磁盘     LMFS · %d 块 · 已挂载\n", rd32(fsbuf, 8), 0, 0);
  } else {
    con_setattr(0x0C);
    kprintf("[FAIL] 磁盘     无法挂载 LMFS\n", 0, 0, 0);
    con_setattr(0x0A);
  }

  /* 中断打开 */
  cpu_irq_on();

  /* 空闲任务 (槽 0) */
  setup_task(0, 0x1E0000, get_idle_entry(), 0x1E8000, "idle", 0, "");
  t_state[0] = 2;
  cur = 0;

  kprintf("[ OK ] 调度器   协作 + 时间片抢占\n", 0, 0, 0);
  con_setattr(0x08);
  con_puts("  ------------------------------------------------\n");
  con_setattr(0x0A);

  r = do_spawn("lsh.lmx", "");
  if (r < 0) {
    con_setattr(0x0C);
    kprintf("[FAIL] shell    错误码 %d\n", r, 0, 0);
    con_setattr(0x0A);
    while (1) { cpu_hlt(); }
  }
  slot = find_slot(r);
  if (slot < 0) { while (1) { cpu_hlt(); } }
  cpu_irq_off();
  t_state[slot] = 2;
  t_ppid[slot] = 0;
  cur = slot;
  jump_to_task(t_sp[slot]);
}
