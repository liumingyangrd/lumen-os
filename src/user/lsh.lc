/* ============================================================
 *  lsh —— Lumen Shell
 * ============================================================ */

char line[128];
char cmd[64];
char arg[128];
char path[128];

int has_dot(char *s) {
  int i = 0;
  while (s[i]) {
    if (s[i] == 46) return 1;
    i = i + 1;
  }
  return 0;
}

void prompt() {
  setattr(0x0B); puts("lumen");
  setattr(0x08); puts(":");
  setattr(0x0F); puts("~");
  setattr(0x0B); puts("$ ");
  setattr(0x0A);
}

void about() {
  setattr(0x0B);
  puts("\n  Lumen OS 1.0\n");
  setattr(0x0A);
  puts("  ------------------------------------------------\n");
  puts("  架构      LUX-32   自研 32 位精简指令集\n");
  puts("  内核      Lumen    自研内核, 非 Linux / 非 POSIX\n");
  puts("  可执行    LMX      自研可重定位可执行格式 (.lmx)\n");
  puts("  文件系统  LMFS     自研文件系统 (.lmfs 镜像)\n");
  puts("  语言      Lumen-C  自研编译器 lcc -> 原生机器码\n");
  puts("  调度      时间片抢占 + 协作让出\n");
  puts("  ------------------------------------------------\n");
  setattr(0x08);
  puts("  整条链路没有一行别人的代码。\n\n");
  setattr(0x0A);
}

void help() {
  setattr(0x0F); puts("\n  lsh 内置命令\n");
  setattr(0x0A);
  puts("   help          本帮助\n");
  puts("   ver           系统信息\n");
  puts("   clear         清屏\n");
  puts("   echo <文本>   回显\n");
  puts("   exit          结束 shell\n");
  puts("   reboot        重启\n");
  setattr(0x08);
  puts("   其它名字会从磁盘加载 <名字>.lmx 执行\n");
  puts("   可用程序: ls cat calc ps mem date snake hello write rm\n\n");
  setattr(0x0A);
}

int main() {
  int i = 0;
  int j = 0;
  int pid = 0;
  int rc = 0;
  setattr(0x08);
  puts("  输入 help 查看命令, 输入 snake 玩一局\n");
  setattr(0x0A);

  for (;;) {
    prompt();
    readline(line, 128);
    if (line[0] == 0) continue;

    i = 0;
    while (line[i] == 32) i = i + 1;
    j = 0;
    while (line[i] && line[i] != 32) {
      cmd[j] = line[i];
      j = j + 1;
      i = i + 1;
    }
    cmd[j] = 0;
    while (line[i] == 32) i = i + 1;
    j = 0;
    while (line[i]) {
      arg[j] = line[i];
      j = j + 1;
      i = i + 1;
    }
    arg[j] = 0;
    if (cmd[0] == 0) continue;

    if (strcmp(cmd, "help") == 0) help();
    else if (strcmp(cmd, "ver") == 0) about();
    else if (strcmp(cmd, "clear") == 0) clear();
    else if (strcmp(cmd, "echo") == 0) { puts(arg); puts("\n"); }
    else if (strcmp(cmd, "exit") == 0) exit(0);
    else if (strcmp(cmd, "reboot") == 0) reboot();
    else {
      strcpy(path, cmd);
      if (!has_dot(path)) strcat(path, ".lmx");
      pid = spawn(path, arg);
      if (pid < 0) {
        setattr(0x0C);
        printf("  lsh: %s: 没有这个命令 (%d)\n", path, pid, 0);
        setattr(0x0A);
      } else {
        rc = wait(pid);
        while (rc == -2) {
          rc = wait(pid);
          yield();
        }
      }
    }
  }
  return 0;
}
